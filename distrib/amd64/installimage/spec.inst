# MINIX amd64 UEFI installer image files.
./mnt2			type=dir mode=0755 uname=root gname=wheel
./targetroot		type=dir mode=0755 uname=root gname=wheel

./install.sh		type=file mode=0755 uname=root gname=wheel
./setup-amd64.sh	type=file mode=0755 uname=root gname=wheel
./boot.cfg		type=file mode=0644 uname=root gname=wheel

# For manual inspection of the release tree on the installation media.
./release		type=link mode=0755 uname=root gname=wheel link=.
