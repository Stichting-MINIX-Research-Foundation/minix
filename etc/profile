#
# System-wide .profile file for sh(1).

# MINIX specifics
# No LD_LIBRARY_PATH (as on NetBSD): the dynamic linker searches it before a
# library's RPATH, so it made base libraries shadow same-named pkgsrc ones.
# Base libraries are in /usr/lib, which ld.elf_so always searches.

# Set the timezone
export TZ=GMT0
RC_TZ=/etc/rc.timezone

if [ -f ${RC_TZ} ]; then
	. ${RC_TZ}
fi

export TZ
